{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [ "schemaVersion", "events" ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "events": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [ "key", "towerDefId", "enabled", "worldTemplate", "zoneGroupId", "trigger", "sites" ],
                "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "towerDefId": { "type": "integer", "minimum": 1 },
                    "enabled": { "type": "boolean" },
                    "worldTemplate": { "type": "string", "minLength": 1 },
                    "zoneGroupId": { "type": "integer", "minimum": 0 },
                    "trigger": {
                        "type": "object",
                        "required": [ "type", "hour", "dayInterval", "dayPhase", "catchUpGraceSeconds" ],
                        "properties": {
                            "type": { "enum": [ "TimeOfDay", "Manual", "ZoneState", "DependencyCompleted" ] },
                            "hour": { "type": "number", "minimum": 0, "exclusiveMaximum": 24 },
                            "dayInterval": { "type": "integer", "minimum": 1 },
                            "dayPhase": { "type": "integer", "minimum": 0 },
                            "catchUpGraceSeconds": { "type": "integer", "minimum": 0 }
                        }
                    },
                    "sites": { "type": "array", "minItems": 1 }
                }
            }
        }
    }
}
