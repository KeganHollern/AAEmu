{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AAEmu Content Studio baseline descriptor",
    "type": "object",
    "required": ["schemaVersion", "key", "clientBuild", "sha256", "length", "tableCount", "requiredTables"],
    "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "key": { "type": "string", "minLength": 1 },
        "clientBuild": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "length": { "type": "integer", "minimum": 1 },
        "tableCount": { "type": "integer", "minimum": 1 },
        "requiredTables": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
            }
        }
    },
    "additionalProperties": true
}
