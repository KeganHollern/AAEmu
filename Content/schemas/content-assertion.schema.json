{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AAEmu Content Studio artifact assertion",
    "type": "object",
    "required": ["schemaVersion", "key", "description", "query", "expected"],
    "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "key": { "type": "string", "pattern": "^assertion\\.[a-z0-9][a-z0-9._-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" }
    },
    "additionalProperties": false
}
