{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AAEmu Content Studio ID registry",
    "type": "object",
    "required": ["schemaVersion", "ranges", "allocations", "tombstones"],
    "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "ranges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/range" } },
        "allocations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/allocationMap" } },
        "tombstones": { "type": "object", "additionalProperties": { "$ref": "#/$defs/allocationMap" } }
    },
    "$defs": {
        "id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "range": {
            "type": "object",
            "required": ["start", "end"],
            "properties": { "start": { "$ref": "#/$defs/id" }, "end": { "$ref": "#/$defs/id" } },
            "additionalProperties": false
        },
        "allocationMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } }
    },
    "additionalProperties": false
}
