@page "/build"
@inject DesignerWorkspace Workspace

<PageTitle>Review & Publish</PageTitle>

<header class="page-head compact">
    <div>
        <p class="eyebrow">FINAL REVIEW</p>
        <h1>Review and publish</h1>
        <p class="lede">Content Studio checks every saved change, prepares a matched game-data package, and publishes only when you choose a destination.</p>
    </div>
    <button class="button primary" @onclick="BuildArtifact" disabled="@_busy">@(_busy ? "Preparing…" : "Check and prepare")</button>
</header>

<section class="metric-grid">
    <article class="metric">
        <small>Safety checks</small>
        <strong class="@(_validation?.IsValid == true ? "good" : "")">@ValidationStatus</strong>
        <button class="text-button" @onclick="Validate" disabled="@_busy">Check now</button>
    </article>
    <article class="metric">
        <small>Publish package</small>
        <strong>@(_result is null ? "Not prepared" : "Ready")</strong>
        <span>@(_result is null ? "Created after all checks pass" : "Verified for the selected baseline")</span>
    </article>
    <article class="metric">
        <small>Saved changes</small>
        <strong>@_savedChangeCount</strong>
        <span>@(_result is null ? "Prepare to review the final list" : ChangeCountSummary())</span>
    </article>
</section>

@if (_result is not null)
{
    <section class="two-column">
        <article class="panel">
            <p class="eyebrow">READY FOR REVIEW</p>
            <h2>What will change</h2>
            <p>This is the exact saved work included in the prepared package.</p>
            <div class="issue-list">
                @foreach (var change in _result.Manifest.Changes)
                {
                    <div class="issue information"><strong>@FriendlyChangeType(change.EntityType)</strong><span>@DesignerMessage.ForUser(change.Summary)</span></div>
                }
            </div>
        </article>
        <article class="panel">
            <p class="eyebrow">CHOOSE A DESTINATION</p>
            <h2>Publish prepared changes</h2>
            <p>Content Studio saves a restore copy of the current game data before every publish.</p>
            @foreach (var target in _targets)
            {
                <div class="deploy-row">
                    <div><strong>@FriendlyTarget(target.Key)</strong><span>@TargetExplanation(target.Key)</span></div>
                    <button class="button danger" @onclick="() => Deploy(target.Key)" disabled="@_busy">Publish here</button>
                </div>
            }
        </article>
    </section>
}

@if (_validation is not null && !_validation.IsValid)
{
    <section class="panel">
        <p class="eyebrow">NEEDS ATTENTION</p>
        <h2>Fix these before publishing</h2>
        <div class="issue-list">
            @foreach (var issue in _validation.Issues.Where(issue => issue.Severity == ValidationSeverity.Error))
            {
                <div class="issue error"><strong>Action needed</strong><span>@DesignerMessage.ForUser(issue.Message)</span></div>
            }
        </div>
    </section>
}

@if (!string.IsNullOrEmpty(_message)) { <div class="toast @(_isError ? "error" : "success")">@_message</div> }

@code {
    private ValidationReport? _validation;
    private ContentBuildResult? _result;
    private Dictionary<string, DeploymentTarget> _targets = [];
    private bool _busy;
    private int _savedChangeCount;
    private string? _message;
    private bool _isError;

    private string ValidationStatus => _validation is null ? "Not run yet" : _validation.IsValid ? "Passed" : "Needs attention";

    protected override void OnInitialized()
    {
        try
        {
            var configuration = Workspace.LoadConfiguration();
            _targets = configuration.Targets;
            var project = new ProjectRepository().LoadProject(configuration.ProjectPath);
            _savedChangeCount = project.Recipes.Count + project.Workbenches.Count + project.Records.Count + project.Assertions.Count;
        }
        catch (Exception exception) { _message = DesignerMessage.ForUser(exception); _isError = true; }
    }

    private void Validate()
    {
        Try(() =>
        {
            var configuration = Workspace.LoadConfiguration();
            var project = new ProjectRepository().LoadProject(configuration.ProjectPath);
            _validation = new ContentValidator().ValidateProject(project, configuration.BaselinePath);
            _message = _validation.IsValid ? "All saved changes passed the safety checks." : "Some saved changes need attention before publishing.";
        }, null);
    }

    private void BuildArtifact()
    {
        _busy = true;
        Try(() =>
        {
            var configuration = Workspace.LoadConfiguration();
            _result = new BuildService().Build(new ContentBuildRequest
            {
                BaselinePath = configuration.BaselinePath,
                BaselineDescriptorPath = configuration.BaselineDescriptorPath,
                ProjectPath = configuration.ProjectPath,
                OutputDirectory = configuration.OutputDirectory
            });
            _validation = _result.Manifest.Validation;
            _targets = configuration.Targets;
            _savedChangeCount = _result.Manifest.Changes.Count + _result.Manifest.AssertionCount;
        }, "The publish package is ready. Review the changes, then choose where to publish it.");
        _busy = false;
    }

    private void Deploy(string name) => Try(() =>
    {
        if (_result is null) throw new ContentStudioException("Prepare the changes before publishing.");
        var configuration = Workspace.LoadConfiguration();
        new DeploymentService().Deploy(_result.ArtifactPath, _result.Manifest.ArtifactSha256, name, configuration.Targets[name], configuration.OutputDirectory);
        _message = $"Published successfully to {FriendlyTarget(name)}. A restore copy was created automatically.";
    }, null);

    private void Try(Action action, string? success)
    {
        try { action(); _isError = false; if (success is not null) _message = success; }
        catch (Exception exception) { _isError = true; _message = DesignerMessage.ForUser(exception); }
    }

    private string ChangeCountSummary() => $"{_result!.Manifest.RecipeCount} recipes · {_result.Manifest.Changes.Count(change => change.EntityType == "record")} other entries · {_result.Manifest.AssertionCount} release checks";
    private static string FriendlyChangeType(string value) => value.ToLowerInvariant() switch { "recipe" => "Recipe", "workbench" => "Workbench", "record" => "Game entry", _ => CatalogRecordService.FriendlyName(value) };
    private static string FriendlyTarget(string value) => value.Contains("client", StringComparison.OrdinalIgnoreCase) ? "Client game data" : value.Contains("server", StringComparison.OrdinalIgnoreCase) ? "Server game data" : CatalogRecordService.FriendlyName(value);
    private static string TargetExplanation(string value) => value.Contains("client", StringComparison.OrdinalIgnoreCase) ? "What players' games use for names, recipes, and matching content" : value.Contains("server", StringComparison.OrdinalIgnoreCase) ? "What the running AAEmu world uses for gameplay rules" : "A configured publishing destination";
}
