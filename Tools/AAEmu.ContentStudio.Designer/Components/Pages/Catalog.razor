@page "/catalog"
@inject DesignerWorkspace Workspace

<PageTitle>Game Search</PageTitle>

<header class="page-head search-heading">
    <div>
        <p class="eyebrow">DISCOVER THE COMPACT</p>
        <h1>Search the whole game</h1>
        <p class="lede">Use the name you would use in conversation. Search abilities and skillsets, individual skills, items, recipes, workbenches, NPCs, quests, zones, and every other translated game entry together.</p>
    </div>
</header>

<section class="search-hero panel">
    <div class="search-box">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input aria-label="Search everything" @bind="_query" @bind:event="oninput" @onkeydown="HandleKey" placeholder="Try “archeum”, “alchemy workbench”, an NPC name, quest, skill, or ID…" autofocus />
        <button class="button primary" @onclick="Search" disabled="@_busy">@(_busy ? "Searching…" : "Search")</button>
    </div>
    <div class="search-examples">
        <span>Not sure where to start?</span>
        @foreach (var example in s_examples)
        {
            <button @onclick="() => SearchFor(example)">@example</button>
        }
    </div>
</section>

@if (_response is null)
{
    <section class="discovery-grid">
        <article class="discovery-card"><span>01</span><h2>Search normal names</h2><p>No table name or ID required. Partial words and small spelling mistakes are okay.</p></article>
        <article class="discovery-card"><span>02</span><h2>Follow relationships</h2><p>An item search also finds recipes that use or produce it, then the workbenches offering those recipes.</p></article>
        <article class="discovery-card"><span>03</span><h2>Change or copy anything</h2><p>Open an entry to see every field with explanations, then plan a change or make a safe custom copy.</p></article>
    </section>
    <section class="panel searchable-things">
        <p class="eyebrow">SEARCHABLE BY NAME</p>
        <div>
            @foreach (var label in s_searchableKinds)
            {
                <span>@label</span>
            }
        </div>
    </section>
}
else if (_response.Results.Count == 0)
{
    <section class="panel empty-search">
        <h2>No results for “@_response.Query”</h2>
        <p>Try a shorter phrase, one distinctive word, or an ID. Searching <button class="inline-action" @onclick='() => SearchFor("archeum")'>archeum</button> is a useful example.</p>
    </section>
}
else
{
    <section class="results-head">
        <div><strong>@_response.Results.Count</strong> top matches for “@_response.Query”</div>
        @if (_response.UsedFuzzyMatching)
        {
            <span class="fuzzy-note">Includes close spelling matches</span>
        }
    </section>
    <nav class="facet-bar" aria-label="Result types">
        @foreach (var filter in KindFilters())
        {
            <button class="@(_activeKind == filter.Key ? "active" : null)" @onclick="() => SetFilter(filter.Key)">@filter.Label <span>@filter.Count</span></button>
        }
    </nav>

    <section class="search-workspace">
        <div class="result-list">
            @foreach (var result in VisibleResults())
            {
                <button class="search-result @SelectedClass(result)" @onclick="() => Inspect(result)">
                    <span class="kind-badge @result.Kind">@result.KindLabel</span>
                    <span class="result-copy">
                        <strong>@result.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(result.Context))
                        {
                            <small>@result.Context</small>
                        }
                    </span>
                    <code>@result.Id</code>
                    <span class="result-arrow">›</span>
                </button>
            }
        </div>

        <aside class="inspector panel">
            @if (_selected is null)
            {
                <div class="inspector-empty"><span>↖</span><h2>Choose a result</h2><p>Its useful relationships and next actions will appear here.</p></div>
            }
            else
            {
                <div class="inspector-title"><span class="kind-badge @_selected.Kind">@_selected.KindLabel</span><code>ID @_selected.Id</code></div>
                <h2>@_selected.Name</h2>
                @if (_selected.Kind != "ability" && !string.IsNullOrWhiteSpace(_selected.Context)) { <p class="match-context">@_selected.Context</p> }

                @if (_recipe is not null)
                {
                    <div class="detail-stats"><span><small>Labor</small><strong>@_recipe.LaborCost</strong></span><span><small>Cast</small><strong>@(_recipe.CastingTime / 1000d) sec</strong></span><span><small>Workbench</small><strong>@(_recipe.RequiredDoodadId == 0 ? "Any" : _recipe.RequiredDoodadId)</strong></span></div>
                    <h3>Materials</h3>
                    <ul class="ingredient-list">@foreach (var material in _recipe.Materials){<li><span>@material.ItemName</span><strong>× @material.Amount</strong><code>@material.ItemId</code></li>}</ul>
                    <h3>Products</h3>
                    <ul class="ingredient-list">@foreach (var product in _recipe.Products){<li><span>@product.ItemName</span><strong>× @product.Amount</strong><code>@product.ItemId</code></li>}</ul>
                    <a class="button primary inspector-action" href="@($"/recipes?source={_recipe.Id}")">Use as recipe source</a>
                    <a class="button inspector-action secondary-action" href="@DetailsUrl(_selected)">View every field</a>
                }
                else if (_workbench is not null)
                {
                    <div class="detail-stats"><span><small>Groups</small><strong>@_workbench.Groups.Count</strong></span><span><small>Functions</small><strong>@_workbench.Groups.Sum(group => group.Functions.Count)</strong></span><span><small>Recipes</small><strong>@_workbench.RecipeIds.Count</strong></span></div>
                    <h3>Recipes available here</h3>
                    @if (_workbenchRecipes.Count == 0) { <p class="muted-copy">No recipes were resolved for this workbench.</p> }
                    else { <ul class="linked-list">@foreach(var recipe in _workbenchRecipes){<li><button @onclick="() => SearchFor(recipe.Name)"><span>@recipe.Name</span><code>@recipe.Id</code></button></li>}</ul> }
                    <a class="button primary inspector-action" href="@($"/workbenches?source={_workbench.Id}")">Use as workbench source</a>
                    <a class="button inspector-action secondary-action" href="@DetailsUrl(_selected)">View every field</a>
                }
                else if (_ability is not null)
                {
                    <p class="muted-copy">@_ability.Description</p>
                    <div class="detail-stats"><span><small>Visible skills</small><strong>@_ability.Skills.Count(skill => skill.Visible)</strong></span><span><small>All skill rows</small><strong>@_ability.Skills.Count</strong></span><span><small>Ability ID</small><strong>@_ability.Id</strong></span></div>
                    <h3>Skills in this ability</h3>
                    <ul class="linked-list ability-skills">@foreach(var skill in _ability.Skills.Where(skill => skill.Visible).Take(80)){<li><a href="@($"/entry?table=skills&id={skill.Id}")"><span><strong>@skill.Name</strong><small>Available at ability level @skill.RequiredAbilityLevel</small></span><code>@skill.Id</code></a></li>}</ul>
                }
                else if (_selected.Kind == "item" && _selected.Table == "items")
                {
                    @if (_itemProfile?.IsEquipment == true)
                    {
                        <section class="gear-profile" aria-label="Equipment gameplay details">
                            <div class="relationship-heading"><h3>Equipment stats</h3><span>@_itemProfile.GearKind</span></div>
                            <div class="detail-stats gear-summary">
                                <span><small>Type</small><strong>@_itemProfile.EquipmentType</strong></span>
                                <span><small>Item level</small><strong>@_itemProfile.ItemLevel</strong></span>
                                <span><small>Required level</small><strong>@(_itemProfile.RequiredLevel == 0 ? "None" : _itemProfile.RequiredLevel)</strong></span>
                            </div>
                            <p class="muted-copy gear-note">Exact numbers scale with the item's grade and, in game, tempering. This shows the template's stat allocation and every directly linked equipment rule.</p>
                            @if (_itemProfile.StatWeights.Count > 0)
                            {
                                <h4>Primary stat profile</h4>
                                <div class="stat-weight-list">
                                    @foreach (var stat in _itemProfile.StatWeights)
                                    {
                                        <div><span><strong>@stat.Name</strong><small>@stat.Percentage% of the primary-stat allocation</small></span><span class="stat-weight-track"><i style="width: @stat.Percentage%"></i></span><code>weight @stat.Weight</code></div>
                                    }
                                </div>
                            }
                            <div class="gear-properties">
                                <span><small>Can be graded</small><strong>@YesNo(_itemProfile.Gradable)</strong></span>
                                <span><small>Enchantable</small><strong>@YesNo(_itemProfile.Enchantable)</strong></span>
                                <span><small>Repairable</small><strong>@YesNo(_itemProfile.Repairable)</strong></span>
                                @if (_itemProfile.AttackSpeed > 0) { <span><small>Attack speed value</small><strong>@_itemProfile.AttackSpeed</strong></span> }
                                @if (_itemProfile.DamageScale > 0) { <span><small>Damage scale</small><strong>@_itemProfile.DamageScale</strong></span> }
                                @if (_itemProfile.ArmorBasisPoints > 0) { <span><small>Armor basis</small><strong>@_itemProfile.ArmorBasisPoints</strong></span> }
                                @if (_itemProfile.MagicResistanceBasisPoints > 0) { <span><small>Magic resistance basis</small><strong>@_itemProfile.MagicResistanceBasisPoints</strong></span> }
                            </div>
                            @if (_itemProfile.Effects.Count > 0)
                            {
                                <h4>Built-in effects</h4>
                                <div class="gear-effect-list">@foreach (var effect in _itemProfile.Effects) { <GearEffectCard Effect="effect" /> }</div>
                            }
                            @if (_itemProfile.EquipmentSet is not null)
                            {
                                var equipmentSet = _itemProfile.EquipmentSet;
                                <section class="equipment-set">
                                    <div class="relationship-heading"><h3>@equipmentSet.Name</h3><span>@equipmentSet.Pieces.Count pieces</span></div>
                                    @if (!string.IsNullOrWhiteSpace(equipmentSet.Description)) { <p class="muted-copy">@equipmentSet.Description</p> }
                                    <h4>Items in this set</h4>
                                    <ul class="linked-list set-piece-list">@foreach (var piece in equipmentSet.Pieces) { <li><a href="@($"/entry?table=items&id={piece.Id}")"><span><strong>@piece.Name</strong><small>@piece.GearKind</small></span><code>@piece.Id</code></a></li> }</ul>
                                    <h4>Set bonuses</h4>
                                    @if (equipmentSet.Bonuses.Count == 0) { <p class="empty-related">No set bonuses are defined.</p> }
                                    else
                                    {
                                        <div class="set-bonus-list">
                                            @foreach (var bonus in equipmentSet.Bonuses)
                                            {
                                                <article><strong>@(bonus.RequiredPieces)-piece bonus</strong>@if (bonus.Buff is not null) { <GearEffectCard Effect="bonus.Buff" /> }@if (bonus.Proc is not null) { <GearEffectCard Effect="bonus.Proc" /> }</article>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                        </section>
                    }
                    <p class="muted-copy">Every recipe below directly consumes this item. The list is loaded from the complete crafting data, independently of the general search-result limit.</p>
                    @if (_itemRecipes.Count > 0)
                    {
                        <div class="relationship-heading"><h3>Direct recipes</h3><span>@_itemRecipes.Count total</span></div>
                        <ul class="linked-list item-recipe-scroll">@foreach(var recipe in _itemRecipes){<li><button @onclick="() => InspectDirectRecipe(recipe)"><span>@recipe.RecipeName<small>Consumes @recipe.Amount × @_selected.Name</small></span><code>@recipe.RecipeId</code></button></li>}</ul>
                    }
                    else
                    {
                        <p class="empty-related">No recipe directly consumes this item.</p>
                    }
                    <a class="button primary inspector-action" href="@DetailsUrl(_selected)">View all data · change · copy</a>
                }
                else
                {
                    <p class="muted-copy">Open the full entry to see every available setting and translation. Important fields include plain-language explanations; technical names are kept under the advanced details.</p>
                    <a class="button primary inspector-action" href="@DetailsUrl(_selected)">View all data · change · copy</a>
                }
            }
        </aside>
    </section>
}

<details class="advanced-search panel">
    <summary>Advanced: inspect database table schemas</summary>
    <div class="advanced-row"><input @bind="_schemaQuery" @bind:event="oninput" placeholder="Table name, for example quest or doodad" /><button class="button" @onclick="InspectSchema">Find tables</button></div>
    @if (_schemas is not null)
    {
        <div class="schema-list">@foreach(var schema in _schemas.Take(40)){<span><strong>@schema.Name</strong><small>@schema.RowCount.ToString("N0") rows · @schema.Columns.Count columns</small></span>}</div>
    }
</details>

@if (!string.IsNullOrWhiteSpace(_error)) { <div class="toast error">@_error</div> }

@code {
    private static readonly string[] s_examples = ["abilities", "Battlerage", "Unstable Solution", "archeum", "alchemy", "merchant"];
    private static readonly string[] s_searchableKinds = ["Abilities / skillsets", "Individual skills", "Buffs", "Items", "Recipes", "Workbenches", "NPCs", "Quests", "Achievements", "Titles", "Zones", "Housing", "Vehicles", "Interface text", "and more"];
    private static readonly (string Key, string Label)[] s_filters = [("all", "All"), ("ability", "Abilities"), ("skill", "Skills"), ("buff", "Buffs"), ("item", "Items"), ("recipe", "Recipes"), ("workbench", "Workbenches"), ("npc", "NPCs"), ("quest", "Quests"), ("world", "World"), ("achievement", "Achievements"), ("other", "Other")];

    private string _query = "";
    private string _activeKind = "all";
    private string _schemaQuery = "";
    private bool _busy;
    private string? _error;
    private CatalogSearchResponse? _response;
    private CatalogSearchResult? _selected;
    private RecipeGraph? _recipe;
    private WorkbenchGraph? _workbench;
    private AbilityGraph? _ability;
    private ItemGameplayProfile? _itemProfile;
    private IReadOnlyList<RecipeGraph> _workbenchRecipes = [];
    private IReadOnlyList<ItemRecipeRelationship> _itemRecipes = [];
    private IReadOnlyList<TableSchema>? _schemas;

    private async Task HandleKey(KeyboardEventArgs args) { if (args.Key == "Enter") await Search(); }
    private async Task SearchFor(string query) { _query = query; await Search(); }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        try
        {
            _busy = true; _error = null; _selected = null; _recipe = null; _workbench = null; _ability = null; _itemProfile = null; _workbenchRecipes = []; _itemRecipes = [];
            var config = Workspace.LoadConfiguration();
            _response = await Task.Run(() => new CatalogSearchService().SearchEverything(config.BaselinePath, _query, limit: 60));
            _activeKind = "all";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task Inspect(CatalogSearchResult result)
    {
        try
        {
            _selected = result; _recipe = null; _workbench = null; _ability = null; _itemProfile = null; _workbenchRecipes = []; _itemRecipes = []; _error = null;
            var config = Workspace.LoadConfiguration();
            var catalog = new CompactCatalogService();
            if (result.Kind == "recipe")
            {
                _recipe = await Task.Run(() => catalog.GetRecipe(config.BaselinePath, result.Id));
            }
            else if (result.Kind == "workbench")
            {
                _workbench = await Task.Run(() => catalog.GetWorkbench(config.BaselinePath, result.Id));
                if (_workbench is not null)
                {
                    _workbenchRecipes = await Task.Run(() => _workbench.RecipeIds.Take(40).Select(id => catalog.GetRecipe(config.BaselinePath, id)).Where(recipe => recipe is not null).Cast<RecipeGraph>().ToList());
                }
            }
            else if (result.Kind == "ability")
            {
                _ability = await Task.Run(() => new CatalogRecordService().GetAbility(config.BaselinePath, result.Id));
            }
            else if (result.Kind == "item" && result.Table == "items")
            {
                var itemTask = Task.Run(() => new ItemGameplayService().GetProfile(config.BaselinePath, result.Id));
                var recipeTask = Task.Run(() => catalog.GetRecipesConsumingItem(config.BaselinePath, result.Id));
                await Task.WhenAll(itemTask, recipeTask);
                _itemProfile = await itemTask;
                _itemRecipes = await recipeTask;
            }
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private IEnumerable<CatalogSearchResult> VisibleResults() => _response?.Results.Where(MatchesActiveFilter) ?? [];
    private Task InspectDirectRecipe(ItemRecipeRelationship recipe) => Inspect(new CatalogSearchResult
    {
        Id = recipe.RecipeId,
        Name = recipe.RecipeName,
        Kind = "recipe",
        KindLabel = "Recipe",
        Table = "crafts",
        Field = "material",
        Context = $"Consumes {recipe.Amount} × {_selected?.Name ?? "this item"}",
        InspectKind = "recipe"
    });
    private bool MatchesActiveFilter(CatalogSearchResult result) => _activeKind == "all" || (_activeKind == "other" ? !s_filters.Any(filter => filter.Key != "all" && filter.Key != "other" && filter.Key == result.Kind) : result.Kind == _activeKind);
    private IEnumerable<(string Key, string Label, int Count)> KindFilters() => s_filters.Select(filter => (filter.Key, filter.Label, Count: _response?.Results.Count(result => filter.Key == "all" || (filter.Key == "other" ? !s_filters.Any(known => known.Key != "all" && known.Key != "other" && known.Key == result.Kind) : result.Kind == filter.Key)) ?? 0)).Where(filter => filter.Count > 0);
    private void SetFilter(string key) { _activeKind = key; _selected = null; _recipe = null; _workbench = null; _ability = null; _itemProfile = null; _workbenchRecipes = []; _itemRecipes = []; }
    private string SelectedClass(CatalogSearchResult result) => _selected?.Table == result.Table && _selected.Id == result.Id ? "selected" : "";
    private static string DetailsUrl(CatalogSearchResult result) => $"/entry?table={Uri.EscapeDataString(result.Table)}&id={result.Id}";
    private static string YesNo(bool value) => value ? "Yes" : "No";

    private void InspectSchema()
    {
        try { var config = Workspace.LoadConfiguration(); _schemas = new CompactCatalogService().ListSchema(config.BaselinePath, _schemaQuery); _error = null; }
        catch (Exception exception) { _error = exception.Message; }
    }
}
